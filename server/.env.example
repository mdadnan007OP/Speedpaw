# SpeedPaw Backend Production Environment Variables Configuration
# Copy this file to .env in your server directory: `cp .env.example .env`

# Network Port for Node.js Express Server
PORT=3001

# Environment Mode (production / development)
NODE_ENV=production

# Allowed CORS Origins (comma-separated origins or wildcard patterns)
# Change to your real production domain when known (e.g. https://speedpaw.com, https://*.pages.dev)
ALLOWED_ORIGINS=https://speedpaw.pages.dev

# Server Diagnostic Metadata (Returned by /api/config endpoint)
# Hyderabad Node (Region: ap-south-2):
SERVER_NAME=SpeedPaw AWS Hyderabad Node 1
SERVER_LOCATION=Hyderabad, India
SERVER_REGION=ap-south-2

# Mumbai Node (Region: ap-south-1) Example:
# SERVER_NAME=SpeedPaw AWS Mumbai Node 1
# SERVER_LOCATION=Mumbai, India
# SERVER_REGION=ap-south-1
